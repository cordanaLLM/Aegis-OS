// Markdown lint policy. Every default rule stays on. The single exception is
// structural: a GitHub Flavored Markdown table row cannot be wrapped without
// breaking the table, and the requirement, task and milestone registers are
// tables by design, so MD013 skips table rows. Prose, headings and code blocks
// are still held to the 80-column limit.
{
  "config": {
    "default": true,
    "MD013": { "tables": false }
  },
  "globs": ["**/*.md"],
  "ignores": [
    ".workingdir/**",
    ".workingdir2/**",
    "site/**",
    "target/**"
  ]
}
