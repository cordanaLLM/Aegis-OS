#
# M26 base-support fragment, applied to x86_64_defconfig BEFORE
# 50-aegis-requirement.config.
#
# Nothing here is a product requirement. Every line is either a Kconfig
# prerequisite the requirement rows depend on, or a guest-boot prerequisite the
# read-back needs. The product requirement lives in
# 50-aegis-requirement.config, which is rendered by
# KernelRequirement::config_fragment from build/kernel-requirement.json and is
# byte-identical to that renderer's output (asserted by
# crates/aegis-fabrica-defs/tests/kernel_fragment.rs). Keeping the two apart is
# what makes the M18 schema the source of the requirement rather than a
# description of a hand-written file.
#
# Each symbol below was read out of the pinned source's own Kconfig files, not
# from memory. The dependency it satisfies is named on the line above it.

# PREEMPT_RT: "depends on EXPERT && ARCH_SUPPORTS_RT && !COMPILE_TEST"
# (kernel/Kconfig.preempt). ARCH_SUPPORTS_RT is selected by arch/x86/Kconfig.
CONFIG_EXPERT=y

# BPF_LSM: "depends on BPF_EVENTS", "depends on SECURITY", "depends on BPF_JIT"
# (kernel/bpf/Kconfig). BPF_EVENTS is a def_bool over BPF_SYSCALL, PERF_EVENTS
# and a *probe event type, so KPROBES and PERF_EVENTS are named here too.
CONFIG_BPF_JIT=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_KPROBES=y
CONFIG_PERF_EVENTS=y

# DYNAMIC_FTRACE_WITH_DIRECT_CALLS (D107) has no prompt: it is a def_bool that
# "depends on DYNAMIC_FTRACE_WITH_REGS || DYNAMIC_FTRACE_WITH_ARGS" and
# "depends on HAVE_DYNAMIC_FTRACE_WITH_DIRECT_CALLS"; both WITH_ symbols are
# def_bools that "depends on DYNAMIC_FTRACE", and DYNAMIC_FTRACE "depends on
# FUNCTION_TRACER" (kernel/trace/Kconfig). FUNCTION_TRACER has no default and
# sits inside "if FTRACE", and FTRACE "depends on TRACING_SUPPORT"
# (kernel/trace/Kconfig). arch/x86/Kconfig selects HAVE_FUNCTION_TRACER,
# HAVE_DYNAMIC_FTRACE, HAVE_DYNAMIC_FTRACE_WITH_REGS and
# HAVE_DYNAMIC_FTRACE_WITH_DIRECT_CALLS. BPF_LSM depends on FTRACE through
# BPF_EVENTS, which sits inside "if FTRACE" (kernel/trace/Kconfig), but on none
# of FUNCTION_TRACER, DYNAMIC_FTRACE or DYNAMIC_FTRACE_WITH_DIRECT_CALLS, yet an
# LSM program attaches through a BPF trampoline, which patches the -mfentry nop
# FUNCTION_TRACER compiles in.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# DEBUG_INFO_BTF sits inside "if DEBUG_INFO" (lib/Kconfig.debug) and DEBUG_INFO
# is reachable only by leaving the "Debug information" choice's DEBUG_INFO_NONE
# default. SCHED_CLASS_EXT in turn "depends on BPF_SYSCALL && BPF_JIT &&
# DEBUG_INFO_BTF" (kernel/Kconfig.preempt).
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y

# INTEL_RAPL: "depends on X86 && IOSF_MBI" (drivers/powercap/Kconfig), and
# IOSF_MBI "depends on PCI" (arch/x86/Kconfig).
CONFIG_PCI=y
CONFIG_IOSF_MBI=y

# IOMMU_API is not user-selectable: it is selected by an IOMMU driver, so the
# requirement row CONFIG_IOMMU_API=y is satisfiable only if one is enabled.
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y

# The read-back itself: IKCONFIG_PROC is what puts /proc/config.gz in the
# running guest, which is the only in-guest source of the kernel's own
# configuration. Without it the read-back would have to read a build-tree file.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Guest boot and orderly shutdown over the emulated serial line.
CONFIG_BLK_DEV_INITRD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_MAGIC_SYSRQ=y

# The release string. It is what makes the read-back impossible to satisfy with
# the host kernel: the guest must report a release only this build produces, and
# LOCALVERSION_AUTO is off so the string does not move with a git checkout.
CONFIG_LOCALVERSION="-aegis-m26"
# CONFIG_LOCALVERSION_AUTO is not set
