{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":maintainLockFilesWeekly"
  ],
  "labels": ["dependencies"],
  "assignees": [],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Praetor-locked assets: praetorctl audit requires them byte-for-byte, so updates arrive through a praetor pin bump, not here",
      "matchFileNames": [".github/workflows/praetor-docs.yml", "tools/markdownlint/**"],
      "enabled": false
    }
  ]
}
