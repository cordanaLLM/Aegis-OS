{
  "folders": [
    {
      "path": "."
    }
  ],
  "build_systems": [
    {
      "name": "Standards: Verify All",
      "shell_cmd": "make verify-all",
      "working_dir": "$project_path"
    },
    {
      "name": "Standards: Audit",
      "shell_cmd": "if command -v praetorctl >/dev/null 2>&1; then praetorctl audit; elif [ -d ./cmd/standardsctl ]; then go run ./cmd/standardsctl audit; else echo 'HISS-16 governance audit cannot run because praetorctl is not installed' >&2; exit 1; fi",
      "working_dir": "$project_path"
    }
  ],
  "settings": {
    "tab_size": 4,
    "translate_tabs_to_spaces": true,
    "trim_trailing_white_space_on_save": true,
    "ensure_newline_at_eof_on_save": true
  }
}
