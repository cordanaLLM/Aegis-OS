#
# Starts aegis-praetor-bump.service whenever praetorctl is reinstalled, which
# the Praetor checkout's `make dev-install` does after Praetor main moves.
[Unit]
Description=Bump the Aegis-OS praetorctl pin when praetorctl is reinstalled
Documentation=file://@AEGIS_REPO@/docs/build/praetor-bump.md

[Path]
PathChanged=%h/.local/bin/praetorctl
Unit=aegis-praetor-bump.service

[Install]
WantedBy=default.target
